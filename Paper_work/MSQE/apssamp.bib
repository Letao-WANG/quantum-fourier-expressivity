@article{Model-Misspecification,
 ISSN = {00221082, 15406261},
 URL = {http://www.jstor.org/stable/3648200},
 abstract = {In this paper, we study intertemporal portfolio choice when an investor accounts explicitly for model misspecification. We develop a framework that allows for ambiguity about not just the joint distribution of returns for all stocks in the portfolio, but also for different levels of ambiguity for the marginal distribution of returns for any subset of these stocks. We find that when the overall ambiguity about the joint distribution of returns is high, then small differences in ambiguity for the marginal return distribution will result in a portfolio that is significantly under diversified relative to the standard meanvariance portfolio.},
 author = {Raman Uppal and Tan Wang},
 journal = {The Journal of Finance},
 number = {6},
 pages = {2465--2486},
 publisher = {[American Finance Association, Wiley]},
 title = {Model Misspecification and Underdiversification},
